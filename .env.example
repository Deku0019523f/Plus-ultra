# ── Serveur ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# ── Stockage ───────────────────────────────────────────────────────────────
# Dossiers/fichiers de données (sessions, mémoire, sqlite). Laisser vide pour
# utiliser les emplacements par défaut ("./data").
DATA_DIR=
DB_PATH=

# ── Groq (IA texte + transcription vocale) ───────────────────────────────
GROQ_API_KEY=gsk_votre_cle_ici

# Modeles texte, dans l'ordre de priorite (rotation avec fallback).
GROQ_TEXT_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-safeguard-20b,llama-3.1-8b-instant,openai/gpt-oss-120b,meta-llama/llama-4-scout-17b-16e-instruct
GROQ_VOICE_MODEL=whisper-large-v3

# ── Moderation / memoire ─────────────────────────────────────────────────
MAX_WARNINGS=3
MEMORY_LIMIT=1000
MEMORY_CONTEXT_MESSAGES=25

# ── Identite du bot ───────────────────────────────────────────────────────
BOT_NAME=Ultra Agent
# Logo envoye dans le message de bienvenue apres connexion reussie.
BOT_LOGO_URL=https://raw.githubusercontent.com/Deku0019523f/Deku-Analyse/main/Logo.png

# ── WhatsApp (diagnostic pairing) ─────────────────────────────────────────
# A ne remplir QUE si le pairing echoue en boucle et que les logs indiquent
# "Impossible de confirmer la derniere version WA Web" (le VPS n'arrive pas
# a joindre github.com). Format: 2,3000,1023223821 (verifier la version
# actuelle sur https://github.com/WhiskeySockets/Baileys/blob/master/src/Defaults/baileys-version.json)
WA_VERSION=

# ── Bot Telegram (relais pour la connexion WhatsApp) ─────────────────────
# Laisser vide pour desactiver le bot Telegram. Obtenir un token via @BotFather.
TELEGRAM_BOT_TOKEN=

# ── Reponses de l'agent conversationnel ───────────────────────────────────
# Delai aleatoire (ms) avant l'envoi d'une reponse, pour eviter un timing
# instantane trop "robot".
AI_REPLY_DELAY_MIN_MS=10000
AI_REPLY_DELAY_MAX_MS=60000
# Si true, la reponse est envoyee en vocal francais (TTS Google public) au
# lieu du texte. Repli automatique en texte si la synthese echoue.
AI_VOICE_REPLY=false

